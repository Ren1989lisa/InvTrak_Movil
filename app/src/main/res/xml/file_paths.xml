<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permite usar archivos temporales -->
    <cache-path
        name="cache"
        path="." />

    <!-- Permite usar el external cache (necesario si usamos externalCacheDir) -->
    <external-cache-path
        name="external_cache"
        path="." />

    <!-- Opcional: archivos internos -->
    <files-path
        name="files"
        path="." />

</paths>